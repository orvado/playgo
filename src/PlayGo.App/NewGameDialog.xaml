<Window x:Class="PlayGo.App.NewGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Game" SizeToContent="Height" Width="400"
        Background="#14171F" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">
    <Border Background="{StaticResource PanelBg}" Padding="22">
        <StackPanel>
            <TextBlock Text="Start a new game" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,18"/>

            <TextBlock Style="{StaticResource Label}" Text="Board size"/>
            <ComboBox x:Name="SizeCombo" Style="{StaticResource Combo}" Margin="0,0,0,16"
                      SelectionChanged="SizeCombo_SelectionChanged">
                <ComboBoxItem Content="9 × 9 — fast game"/>
                <ComboBoxItem Content="13 × 13 — medium"/>
                <ComboBoxItem Content="19 × 19 — full board"/>
            </ComboBox>

            <TextBlock Style="{StaticResource Label}" Text="Players"/>
            <RadioButton x:Name="ModePvP" Style="{StaticResource RadioRow}" Content="Two humans (on this PC)"/>
            <RadioButton x:Name="ModeVsAI" Style="{StaticResource RadioRow}" Content="Human (Black) vs Computer (White)"/>
            <RadioButton x:Name="ModeVsAIWhite" Style="{StaticResource RadioRow}" Content="Computer (Black) vs Human (White)"/>
            <RadioButton x:Name="ModeAIvAI" Style="{StaticResource RadioRow}" Content="Computer vs Computer (watch)"/>

            <TextBlock Style="{StaticResource Label}" Text="Handicap stones for Black" Margin="0,14,0,6"/>
            <ComboBox x:Name="HandicapCombo" Style="{StaticResource Combo}" Margin="0,0,0,6"
                      SelectionChanged="HandicapCombo_SelectionChanged">
                <ComboBoxItem Content="None — even game"/>
                <ComboBoxItem Content="2 stones"/>
                <ComboBoxItem Content="3 stones"/>
                <ComboBoxItem Content="4 stones"/>
                <ComboBoxItem Content="5 stones"/>
                <ComboBoxItem Content="6 stones"/>
                <ComboBoxItem Content="7 stones"/>
                <ComboBoxItem Content="8 stones"/>
                <ComboBoxItem Content="9 stones"/>
            </ComboBox>
            <TextBlock x:Name="HandicapHint" FontSize="11.5" Foreground="{StaticResource TextDim}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Style="{StaticResource Label}" Text="Komi — White's compensation for moving second"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KomiBox" Grid.Column="0" Style="{StaticResource DialogTextBox}"
                         Width="80" TextChanged="KomiBox_TextChanged"/>
                <TextBlock x:Name="KomiHint" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" Margin="10,0,0,0" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock x:Name="KomiWarning" FontSize="11.5" Foreground="{StaticResource Accent}"
                       TextWrapping="Wrap" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Style="{StaticResource DialogButton}" Content="Cancel" Width="100" Margin="0,0,10,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource DialogButton}" Content="Start Game" Width="120"
                        Background="#3A2E12" BorderBrush="#6B5426" Foreground="{StaticResource Accent}"
                        FontWeight="SemiBold" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
